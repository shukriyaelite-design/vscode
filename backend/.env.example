# Copy these into HostGator cPanel environment variables. Do not commit real values.
SHUKRIYA_ADMIN_EMAIL=contact@shukriya.net
SHUKRIYA_ADMIN_PASSWORD=replace-with-a-long-random-password
SHUKRIYA_MAX_USERS=5
SHUKRIYA_DB=/home/CPANEL_USER/private/shukriya/shukriya.db
SHUKRIYA_PRIVATE_STORAGE=/home/CPANEL_USER/private/shukriya/documents
SHUKRIYA_PAYMENT_PROVIDER=razorpay
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
PORT=8010
SHUKRIYA_COOKIE_SECURE=true
PAYMENT_WEBHOOK_SECRET=replace-with-payment-provider-webhook-secret
SHUKRIYA_LOGIN_MAX_ATTEMPTS=5
SHUKRIYA_LOGIN_LOCK_SECONDS=900
SHUKRIYA_RATE_LIMIT_COUNT=60
SHUKRIYA_RATE_LIMIT_WINDOW=60
