\u0629 \u0644\u0645\u0631\u0643\u0632 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062d\u062c \u0648\u0627\u0644\u0639\u0645\u0631\u0629.",valueEn:"We would like to inform you of a scheduled technical maintenance at the Hajj and Umrah Information Center on Sunday, 18/01/2026, from 6:00 AM to 6:00 PM.\nThe maintenance will impact all services provided by the center, including Nusuk Masar Platform, the Nusuk Mobile Application, and all technical systems under the Hajj & Umrah Information Center."},systemMaintenanceImpact:{valueAr:" \u0642\u062f \u064a\u062a\u0631\u062a\u0628 \u0639\u0644\u0649 \u0630\u0644\u0643 \u062a\u0639\u0630\u0631 \u0623\u0648 \u062a\u0623\u062e\u0631 \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646 \u0628\u0639\u0636 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u062e\u0644\u0627\u0644 \u0641\u062a\u0631\u0629 \u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0639\u0644\u0649 \u0623\u0646 \u064a\u062a\u0645 \u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0641\u0648\u0631 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0627\u0644\u0645\u062c\u062f\u0648\u0644\u0629. \u0646\u0623\u0645\u0644 \u0639\u062f\u0645 \u0641\u062a\u062d \u0628\u0644\u0627\u063a\u0627\u062a \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0647\u0630\u0627 \u0627\u0644\u062a\u0648\u0642\u0641 \u062e\u0644\u0627\u0644 \u0641\u062a\u0631\u0629 \u0627\u0644\u0635\u064a\u0627\u0646\u0629\u060c \u0648\u0633\u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0628\u0639\u062f \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062e\u062f\u0645\u0627\u062a.",valueEn:"During the maintenance window, some services may be temporarily unavailable. Services will resume immediately upon completion of the scheduled maintenance.\nKindly refrain from raising incidents related to this outage during the maintenance period. All inquiries will be handled after service restoration."},thanks:{valueAr:"\u0634\u0627\u0643\u0631\u064a\u0646 \u062a\u0641\u0647\u0645\u0643\u0645 \u0648\u062a\u0639\u0627\u0648\u0646\u0643\u0645",valueEn:"Thank you for your understanding and cooperation"}}}static{this.\u0275fac=function(T){return new(T||m)}}static{this.\u0275cmp=e.VBU({type:m,selectors:[["app-maintenance-alert"]],standalone:!0,features:[e.Vt3,e.aNF],decls:15,vars:4,consts:[[1,"alert-wrapper"],[1,"icon-wrapper"],["xmlns","http://www.w3.org/2000/svg","width","18","height","18","viewBox","0 0 18 18","fill","none"],["d","M8.11849 11.875C8.11849 11.4148 8.49159 11.0417 8.95182 11.0417H8.95931C9.41955 11.0417 9.79264 11.4148 9.79264 11.875C9.79264 12.3352 9.41955 12.7083 8.95931 12.7083H8.95182C8.49159 12.7083 8.11849 12.3352 8.11849 11.875Z","fill","#B54708"],["d","M8.33333 9.375C8.33333 9.72018 8.61316 10 8.95833 10C9.30351 10 9.58333 9.72018 9.58333 9.375V6.04167C9.58333 5.69649 9.30351 5.41667 8.95833 5.41667C8.61316 5.41667 8.33333 5.69649 8.33333 6.04167V9.375Z","fill","#B54708"],["fill-rule","evenodd","clip-rule","evenodd","d","M7.59332 0.220834C8.48037 -0.0736114 9.43631 -0.0736114 10.3234 0.220834C11.2067 0.514062 11.9003 1.20951 12.5971 2.18662C13.2916 3.1605 14.059 4.51838 15.0482 6.26875L15.087 6.33747C16.0764 8.0881 16.8437 9.44592 17.322 10.5471C17.8025 11.6536 18.0418 12.609 17.8509 13.5268C17.6586 14.4509 17.1845 15.2912 16.494 15.9264C15.8052 16.56 14.8673 16.8273 13.6863 16.9557C12.5121 17.0833 10.976 17.0833 8.99896 17.0833H8.91771C6.94068 17.0833 5.40462 17.0833 4.23035 16.9557C3.04939 16.8273 2.11149 16.56 1.42268 15.9264C0.732186 15.2912 0.258066 14.4509 0.0657941 13.5268C-0.125168 12.609 0.114167 11.6536 0.594712 10.5471C1.07293 9.44592 1.84029 8.0881 2.82965 6.33746L2.8684